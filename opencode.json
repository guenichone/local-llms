      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "ornith-1.0-9b-Q4_K_M.gguf": {
          "name": "Ornith-1.0-9B Q4_K_M",
